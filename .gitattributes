# =========================
# GLOBAL SETTINGS
# =========================
* text=auto

# =========================
# FORCE LF (IMPORTANT)
# =========================
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf

*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.md text eol=lf

# =========================
# ENV FILES
# =========================
*.env text eol=lf
*.env.* text eol=lf

# =========================
# DOCKER / SHELL (CRITICAL)
# =========================
Dockerfile text eol=lf
*.dockerignore text eol=lf
*.sh text eol=lf

# =========================
# WINDOWS SCRIPTS
# =========================
*.bat text eol=crlf
*.cmd text eol=crlf

# =========================
# BINARY FILES (NO CONVERSION)
# =========================
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary

*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

*.zip binary
*.tar binary
*.gz binary
